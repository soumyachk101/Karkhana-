{
  "name": "karkhana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'lib/**/*.test.ts'",
    "smoke": "node --experimental-strip-types scripts/smoke.mts",
    "wt:test": "node --experimental-strip-types scripts/wt-test.mts",
    "agent:test": "node --experimental-strip-types scripts/agent-test.mts",
    "db:reset": "rm -f karkhana.db karkhana.db-wal karkhana.db-shm",
    "e2e": "node --experimental-strip-types scripts/e2e-test.mts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "better-sqlite3": "^13.0.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
